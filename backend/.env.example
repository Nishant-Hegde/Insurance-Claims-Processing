# Copy to backend/.env.local and fill in your own values. Never commit .env.local.
DATABASE_URL=postgresql://postgres:<your-password>@localhost:5432/<your-database>

# ClaimGuard embedding service (embedding-service/, FastAPI). Server-side only.
EMBEDDING_SERVICE_URL=http://127.0.0.1:8001

# Optional: how many nearest reference cases each screening stores (1-40, default 5).
# SCREENING_TOP_K=5
